{
  "loanHistory": {
    "html": [
      "<div id='overview-historic-loans-alert' class='loan-history-alert' role='note' aria-labelledby='loan-history-heading'>",
      "  <div class='loan-history-alert__content'>",
      "    <h3 id='loan-history-heading'>JSON - Loan History</h3>",
      "    <p>To protect your privacy, UW-Whitewater Libraries anonymizes all loan history data older than six months.</p>",
      "    <p>",
      "      To retain your future loan data, please",
      "      <a href='https://loanhistory.library.wisconsin.edu/' aria-label='Opt in to retain future loan data'>opt in</a>.",
      "    </p>",
      "    <p>",
      "      For more information about loan history policies, visit the",
      "      <a href='https://libguides.uww.edu/loanhistory' aria-label='Learn more about loan history policies at UW-Whitewater Libraries'>loan history guide</a>.",
      "    </p>",
      "    <p>",
      "      <a href='https://loanhistory.library.wisconsin.edu/'>Loan History app</a>",
      "    </p>",
      "  </div>",
      "</div>"
    ],
    "css": [
      ".loan-history-alert {",
      "  display: flex;",
      "  align-items: center;",
      "  max-width: 500px;",
      "  margin: 20px auto;",
      "  padding: 10px 15px;",
      "  border: 1px solid #60388b;",
      "  border-radius: 5px;",
      "  background: #f6f4fb;",
      "  color: #000;",
      "}",
      "",
      ".loan-history-alert__content {",
      "  width: 100%;",
      "}",
      "",
      ".loan-history-alert h3 {",
      "  margin: 0 0 8px;",
      "  font-size: 1.1rem;",
      "  line-height: 1.25;",
      "}",
      "",
      ".loan-history-alert p {",
      "  margin: 0 0 8px;",
      "  line-height: 1.4;",
      "}",
      "",
      ".loan-history-alert p:last-child {",
      "  margin-bottom: 0;",
      "}",
      "",
      ".loan-history-alert a {",
      "  color: #002255;",
      "  text-decoration: underline;",
      "}"
    ]
  }
}
